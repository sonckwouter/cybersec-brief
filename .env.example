# Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Configuration (Standard Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Gmail App Password (16 characters generated via Google Account Security > 2-Step Verification > App Passwords)
SMTP_PASS=your_16_char_app_password

# Email Recipients & Senders
EMAIL_FROM="CyberSec Brief <your_email@gmail.com>"
EMAIL_TO=recipient@example.com

# Optional: Default Topic (matches key in config/feeds.yaml)
DEFAULT_TOPIC=cyber_security
